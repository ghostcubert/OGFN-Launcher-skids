#Enter name for launcher
VITE_LAUNCHER_NAME="Personal Test"

#Enter launcher version
VITE_LAUNCHER_VERSION="1.0.0"

#Enable/Disable only a certain version joinable
VITE_ONLY_JOINABLE="true"

#Version of only joinable, doesnt do anything if only joinable is on false
VITE_ONLY_JOINABLE_VERSION="8.51,12.41"

#Enable/Disable requiring login, shop, and leaderboard api either true or false
VITE_ENABLE_LOGIN_API="false"

#Enable or disable shop api
VITE_ENABLE_SHOP_API="false"

#Enable/Disable Shop tab
VITE_ENABLE_SHOP_TAB="false"

#Enable or disable leaderboard api
VITE_ENABLE_LEADERBOARD_API="false"

#Enable/Disable Leaderboard tab
VITE_ENABLE_LEADERBOARD_TAB="false"

#Image that displays when no build is imported
VITE_PLACEHOLDER_IMAGE="https://i.imgur.com/UmBKJet.jpeg"

#Enter your backend ip and port in this format "http://127.0.0.1:3551"
VITE_BACKEND_URL="http://127.0.0.1:3551"

#Enter link to your discord server
VITE_DISCORD_LINK="https://discord.gg/Testmp"

#For discord rich presence
VITE_DISCORD_CLIENT_ID="1436393606364663891"

#Enter image for logo link if wanted
VITE_LOGO_URL="https://i.imgur.com/UmBKJet.jpeg"

#Enter image for background link if wanted
VITE_MAIN_BACKGROUND_URL="https://i.imgur.com/dEfhFaf.jpeg"

#Background Image url
VITE_LOGIN_BACKGROUND_URL="https://i.imgur.com/YypWoKR.png"

#Redirect Link
VITE_REDIRECT_LINK="https://github.com/lalaland1212/LocalDLL127001/raw/refs/heads/main/Starfall.dll"

#Dlls to inject to the game, to add multiple do "link,link" NO SPACES
VITE_INJECT_DLLS_LINKS=""

#Paks downloads, to add multiple do "link.pak,link.sig" NO SPACES
VITE_PAKS_AND_SIGS_LINKS=""

#Enable/Disable Download from library tab
VITE_BUILD_DOWNLOAD="true"

#Download url
VITE_BUILD_DOWNLOAD_URL=""

# --------------------STILL NOT ADDED-------------------------

#Layout of tabs
VITE_TABS_LAYOUT=""

#Layout of login
VITE_LOGIN_LAYOUT=""

#Layout of news
VITE_NEWS_LAYOUT=""

# Enable/Disable outside injectors from injection process like UUU, Process Hacker, and Extreme Injector
VITE_ENABLE_EXTERNAL_INJECTORS=""

#Enable/Disable Lookup tab
VITE_ENABLE_LOOKUP_TAB=""

#Choose your themes, example light, dark
VITE_LAUNCHER_THEME=""

#Enable/Disable user changing themes
VITE_LAUNCHER_THEME_USER=""

#Color for launcher
